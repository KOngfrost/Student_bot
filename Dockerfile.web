# Простая сборка для веб-админки
FROM python:3.11.12-slim-bookworm

# Устанавливаем зависимости системы
RUN apt-get update && apt-get install -y \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Создаём непривилегированного пользователя (запуск НЕ от root — безопасность)
RUN useradd --create-home --shell /bin/bash appuser

# Устанавливаем рабочие директории
WORKDIR /app

# Копируем requirements и устанавливаем зависимости
COPY requirements.txt ./
RUN python -m pip install --upgrade pip setuptools wheel \
    && pip install --no-cache-dir -r requirements.txt

# Копируем код приложения
COPY . .

# Права на файлы приложения для appuser
RUN chown -R appuser:appuser /app

USER appuser

# Открываем порт для веб-админки
EXPOSE 8000

# Запускаем веб-админку
CMD ["uvicorn", "web.main:app", "--host", "0.0.0.0", "--port", "8000"]
