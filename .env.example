# ============================================================
# Student Bot — Конфигурация
# ============================================================
# ВНИМАНИЕ: Никогда не коммитьте .env в Git!
# .env уже добавлен в .gitignore.
# ============================================================

# === Database ===
POSTGRES_USER=student_bot
POSTGRES_PASSWORD=change_me
POSTGRES_DB=student_bot
DB_HOST=db
DB_PORT=5432

# === VK Bot ===
# Токен сообщества ВКонтакте (Управление -> Работа с API -> Ключи доступа)
# ⚠️ ОПАСНОСТЬ: Токон даёт полный контроль над ботом.
# ⚠️ ХРАНИТЕ ТОКЕН В БЕЗОПАСНОМ МЕСТЕ, НЕ КОММИТЬТЕ В GIT.
VK_BOT_TOKEN=

# VK ID администраторов через запятую (доступ к админ-командам бота)
ADMIN_VK_IDS=

# VK ID получателя ежедневных отчётов
VK_REPORT_ADMIN_ID=

# Время ежедневного отчёта в формате HH:MM (в часовом поясе APP_TIMEZONE)
REPORT_TIME=09:00

# Часовой пояс для отчётов и отображения времени (даты в БД — в UTC)
APP_TIMEZONE=Europe/Moscow

# Dev-режим: разрешить приложению создавать базу (CREATE DATABASE).
# В PRODUCTION должно быть false — базу создаёт PostgreSQL-контейнер (POSTGRES_DB),
# схему применяет Alembic (docker compose run --rm migrate).
ALLOW_DB_CREATE=false

# === Web admin panel ===
# Стабильный секрет сессий (сгенерируйте: python -c "import secrets; print(secrets.token_urlsafe(64))")
# ⚠️ КРИТИЧНО: Без этого ключа сессии сбрасываются при каждом перезапуске,
# и злоумышленник может перехватить сессию.
# В ПРОДАКШЕНЕ ОБЯЗАТЕЛЬНО установите этот ключ!
SESSION_SECRET_KEY=

# Логин и пароль для входа в веб-админку (bootstrap-суперадмин).
# Используется только пока в web_users нет пользователей.
# Постоянных пользователей создавайте: python scripts/create_web_user.py
WEB_ADMIN_USERNAME=
WEB_ADMIN_PASSWORD=

# === Tailscale (доступ к веб-панели через VPN, опционально) ===
# Auth key из https://login.tailscale.com/admin/settings/keys
# Нужен только при запуске с профилем tailscale:
# docker compose -f docker-compose.yml -f docker-compose.tailscale.override.yml --profile tailscale up -d
TAILSCALE_AUTH_KEY=

# === Email-рассылка отчётов (опционально) ===
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
REPORT_EMAILS=
