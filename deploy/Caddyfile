# Caddy — автоматический TLS для публикации веб-панели в интернет.
#
# Запуск: caddy run --config Caddyfile (или docker run -p 80:80 -p 443:443 ... )
#
# ВАЖНО:
#   - SESSION_HTTPS_ONLY=true в .env веб-панели (кука Secure).
#   - TRUSTED_PROXIES=172.17.0.1 (или подсеть, с которой Caddy проксирует)
#     в .env веб-панели — для корректного IP клиента в rate-limit.
#   - Панель в docker-compose.yml слушает localhost:8000 на хосте.

# Замените на ваш реальный домен (DNS должен указывать на сервер)
panel.example.com {
    reverse_proxy localhost:8000

    # Передача реального IP клиента (белый список — сам Caddy)
    header_up X-Forwarded-For {remote_host}
    header_up X-Real-IP {remote_host}

    # Кэширование отключено (админка)
    header -Cache-Control
    header +Cache-Control "no-store, no-cache, must-revalidate"
    header -Server
}

# Если домена ещё нет — можно использовать HTTPS по IP нельзя (нужен домен).
# Для доступа по локальной сети используйте Tailscale (см. setup_tailscale.sh).